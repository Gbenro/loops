{
  "framework": "vite",
  "buildCommand": "npm run build:beta",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/beta", "destination": "/beta/index.html" },
    { "source": "/beta/", "destination": "/beta/index.html" },
    { "source": "/beta/review", "destination": "/beta/review.html" },
    { "source": "/((?!beta).*)", "destination": "/index.html" }
  ]
}
