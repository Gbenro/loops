{
  "openapi": "3.1.0",
  "info": {
    "title": "Luna Command Center Gateway API",
    "description": "Consolidated 6-operation Command Center Gateway for Luna GPT Custom Actions, unifying Core Personal Field, Development Bridge, Attention Lab V1.1.0, Creative Studio, and Asset Bridge within OpenAI's 30-operation ceiling.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://loops-production-e1d5.up.railway.app",
      "description": "Production Railway Server"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/luna/command-center/capabilities": {
      "get": {
        "operationId": "command_center_capabilities",
        "summary": "Discover Command Center Capabilities & Domain Hubs",
        "description": "Returns dynamic registry of available hubs (core, dev, lab, creative, assets), sub-actions, parameters, and permission scopes.",
        "security": [],
        "responses": {
          "200": {
            "description": "Dynamic registry of capabilities and domain hubs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapabilitiesResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/luna/command-center/core": {
      "post": {
        "operationId": "command_center_core",
        "summary": "Execute Core Personal Field Sub-Action",
        "description": "Executes operations across Personal Field: Lunar context, Echoes (immutable reflections), Loops (intentions), Threads, Relational Memory, and Chat history.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CoreRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sub-action execution result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid sub-action or payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayError"
                }
              }
            }
          },
          "403": {
            "description": "Discovery credentials have zero Personal Field access",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayError"
                }
              }
            }
          }
        }
      }
    },
    "/api/luna/command-center/dev": {
      "post": {
        "operationId": "command_center_dev",
        "summary": "Execute Development Bridge Sub-Action",
        "description": "Executes Development Bridge sub-actions for tracking dev issues, orchestrating agent sessions, posting durable events (with automatic secret redaction), and queue telemetry.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DevRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sub-action execution result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid sub-action or payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayError"
                }
              }
            }
          }
        }
      }
    },
    "/api/luna/command-center/lab": {
      "post": {
        "operationId": "command_center_lab",
        "summary": "Execute Attention Lab Sub-Action",
        "description": "Drives and inspects Attention Lab V1.1.0 experiments, benchmark evaluations, and Model Routing without wasting unnecessary inference tokens.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LabRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sub-action execution result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid sub-action or payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayError"
                }
              }
            }
          }
        }
      }
    },
    "/api/luna/command-center/creative": {
      "post": {
        "operationId": "command_center_creative",
        "summary": "Execute Creative Studio Sub-Action",
        "description": "Scene manifests, shot directions, visual pacing, and strict render lock enforcement for Video 1 (Creating With the Cycles V1).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreativeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sub-action execution result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid sub-action or payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayError"
                }
              }
            }
          }
        }
      }
    },
    "/api/luna/command-center/assets": {
      "post": {
        "operationId": "command_center_assets",
        "summary": "Execute Asset Bridge Sub-Action",
        "description": "Creative Asset Bridge operations: retrieve review-state previews (all 21 visual assets), get binary download URLs, upload binary data via base64 (e.g. Shot 08 round-trip), and acknowledge ingestion.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssetRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sub-action execution result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid sub-action or payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GatewayError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Authentication token provided via Authorization: Bearer <token>. Configure credentials in the GPT Action setup dialog."
      }
    },
    "schemas": {
      "GatewayResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "type": "object"
          }
        },
        "required": [
          "success",
          "data"
        ]
      },
      "GatewayError": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "success",
          "error"
        ]
      },
      "CapabilitiesResponse": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "targetGptOperationCount": {
            "type": "integer",
            "example": 6
          },
          "baselineMigrationCount": {
            "type": "integer",
            "example": 29
          },
          "hubs": {
            "type": "object"
          }
        }
      },
      "CoreRequest": {
        "type": "object",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "lunar.get_context",
              "field.search",
              "echoes.search",
              "echoes.list",
              "echoes.get",
              "echoes.create",
              "echoes.update",
              "echoes.archive",
              "echoes.restore",
              "reflections.create",
              "reflections.attach",
              "loops.list",
              "loops.get",
              "loops.create",
              "loops.update",
              "loops.close",
              "loops.reopen",
              "loops.archive",
              "loops.restore",
              "loops.carry_forward",
              "threads.list",
              "threads.get",
              "threads.create",
              "threads.update",
              "threads.connect_echo",
              "threads.disconnect_echo",
              "chat.list_sessions",
              "chat.get_session",
              "chat.search_messages",
              "chat.evaluations",
              "chat.inference_summary",
              "chat.rename_session",
              "chat.archive_session",
              "chat.preserve_to_field"
            ],
            "description": "Core sub-action identifier"
          },
          "payload": {
            "type": "object",
            "description": "Payload parameters specific to the sub-action",
            "properties": {
              "id": {
                "type": "string",
                "description": "Target ID for echo, loop, thread, or chat session"
              },
              "query": {
                "type": "string",
                "description": "Search query text for field, echo, or chat search"
              },
              "limit": {
                "type": "integer",
                "description": "Maximum number of items to return"
              },
              "text": {
                "type": "string",
                "description": "Text content for echoes or reflections"
              },
              "title": {
                "type": "string",
                "description": "Title for loops, threads, or chat sessions"
              },
              "focus": {
                "type": "string",
                "description": "Focus description for loops"
              },
              "status": {
                "type": "string",
                "description": "Status filter (e.g. active, closed, archived)"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Tags associated with the record"
              },
              "relatedEchoIds": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Echo IDs to link"
              },
              "loopIds": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Loop IDs to link"
              },
              "echoId": {
                "type": "string",
                "description": "Target echo ID for thread connection or reflection attachment"
              },
              "threadId": {
                "type": "string",
                "description": "Target thread ID for echo connection"
              },
              "sessionId": {
                "type": "string",
                "description": "Chat session ID"
              },
              "date": {
                "type": "string",
                "description": "Date filter (YYYY-MM-DD) for telemetry inference summary"
              },
              "reason": {
                "type": "string",
                "description": "Reason for closure or carry-forward"
              },
              "metadata": {
                "type": "object",
                "description": "Optional metadata object"
              }
            }
          }
        }
      },
      "DevRequest": {
        "type": "object",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "dev.issues.list",
              "dev.issues.get",
              "dev.issues.create",
              "dev.issues.update_status",
              "dev.events.list",
              "dev.events.post",
              "dev.sessions.create",
              "dev.sessions.claim",
              "dev.sessions.end",
              "dev.sessions.pending",
              "dev.queue.get_state"
            ],
            "description": "Dev Bridge sub-action identifier"
          },
          "payload": {
            "type": "object",
            "description": "Payload parameters specific to the Dev sub-action",
            "properties": {
              "issueId": {
                "type": "string",
                "description": "Issue ID (e.g. iss_1789850839764_0rbv)"
              },
              "sessionId": {
                "type": "string",
                "description": "Dev session ID (e.g. sess_1789850842760_1kkv)"
              },
              "type": {
                "type": "string",
                "description": "Dev event type (e.g. verification.reported, completion.summary, investigation.started, task.planned, code.modified, test.executed)"
              },
              "author": {
                "type": "string",
                "description": "Event author (luna, gemini, user)",
                "default": "luna"
              },
              "content": {
                "type": "string",
                "description": "Event message or report content"
              },
              "metadata": {
                "type": "object",
                "description": "Structured event metadata"
              },
              "id": {
                "type": "string",
                "description": "Issue ID or Session ID"
              },
              "title": {
                "type": "string",
                "description": "Title for creating an issue"
              },
              "description": {
                "type": "string",
                "description": "Detailed description of an issue"
              },
              "status": {
                "type": "string",
                "description": "Issue status (open, in_progress, resolved, closed)"
              },
              "priority": {
                "type": "string",
                "description": "Issue priority (low, medium, high, critical)"
              },
              "agentName": {
                "type": "string",
                "description": "Agent name for session orchestration (e.g. luna, gemini)"
              },
              "focus": {
                "type": "string",
                "description": "Session focus or objective"
              },
              "limit": {
                "type": "integer",
                "description": "Maximum records to return"
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Issue tags"
              }
            }
          }
        }
      },
      "LabRequest": {
        "type": "object",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "lab.status",
              "lab.attention.plan",
              "lab.attention.run",
              "lab.attention.create_session",
              "lab.attention.inspect_session",
              "lab.attention.list_benchmarks",
              "lab.attention.evaluate_benchmark"
            ],
            "description": "Attention Lab sub-action identifier"
          },
          "payload": {
            "type": "object",
            "description": "Payload parameters specific to the Attention Lab sub-action",
            "properties": {
              "query": {
                "type": "string",
                "description": "Task query or evaluation prompt"
              },
              "tokenBudget": {
                "type": "integer",
                "description": "Maximum token budget for attention routing"
              },
              "condition": {
                "type": "string",
                "description": "Experimental condition or configuration"
              },
              "sessionId": {
                "type": "string",
                "description": "Attention Lab session ID"
              },
              "benchmarkId": {
                "type": "string",
                "description": "Benchmark suite ID to run or inspect"
              },
              "models": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Models to compare or route"
              },
              "metadata": {
                "type": "object",
                "description": "Optional lab run metadata"
              }
            }
          }
        }
      },
      "CreativeRequest": {
        "type": "object",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "creative.manifest.get",
              "creative.shots.list",
              "creative.shots.get",
              "creative.status",
              "creative.render_lock.status"
            ],
            "description": "Creative Studio sub-action identifier"
          },
          "payload": {
            "type": "object",
            "description": "Payload parameters specific to the Creative sub-action",
            "properties": {
              "shotId": {
                "type": "string",
                "description": "Shot identifier (e.g. shot_01, shot_08)"
              },
              "batch": {
                "type": "integer",
                "description": "Batch number filter or selector"
              },
              "status": {
                "type": "string",
                "description": "Shot status filter"
              },
              "renderLocked": {
                "type": "boolean",
                "description": "Render lock state check"
              }
            }
          }
        }
      },
      "AssetRequest": {
        "type": "object",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "assets.list",
              "assets.get",
              "assets.upload",
              "assets.ack",
              "assets.archive"
            ],
            "description": "Asset Bridge sub-action identifier"
          },
          "payload": {
            "type": "object",
            "description": "Payload parameters specific to the Asset Bridge sub-action",
            "properties": {
              "status": {
                "type": "string",
                "description": "Filter assets by status (e.g. review, approved, pending)"
              },
              "id": {
                "type": "string",
                "description": "Asset ID to fetch or acknowledge"
              },
              "filename": {
                "type": "string",
                "description": "Filename of the asset"
              },
              "mimeType": {
                "type": "string",
                "description": "MIME type (e.g. image/png, video/mp4)"
              },
              "dataBase64": {
                "type": "string",
                "description": "Base64-encoded binary asset content"
              },
              "sourceUrl": {
                "type": "string",
                "description": "Public or temporary HTTPS URL of an image/file to fetch and ingest into the bridge"
              },
              "projectId": {
                "type": "string",
                "description": "Project ID (e.g. creating_with_the_cycles_v1)"
              },
              "shotId": {
                "type": "string",
                "description": "Shot ID (e.g. shot_08)"
              },
              "kind": {
                "type": "string",
                "description": "Asset kind (frame, video, audio, texture)"
              },
              "role": {
                "type": "string",
                "description": "Asset role (preview, reference, cut)"
              },
              "prompt": {
                "type": "string",
                "description": "Visual prompt used to generate asset"
              },
              "motionIntent": {
                "type": "string",
                "description": "Motion direction or intent"
              },
              "metadata": {
                "type": "object",
                "description": "Asset metadata"
              }
            }
          }
        }
      }
    }
  }
}