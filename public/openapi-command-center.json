{
  "openapi": "3.1.0",
  "info": {
    "title": "Luna Command Center Gateway API",
    "description": "Consolidated 6-operation Command Center Gateway for Luna GPT Custom Actions, unifying Core Field, Dev Bridge, Attention Lab, Creative Studio, and Asset Bridge within OpenAI's 30-operation ceiling.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://loops-production-e1d5.up.railway.app",
      "description": "Railway Production"
    }
  ],
  "paths": {
    "/api/luna/command-center/capabilities": {
      "get": {
        "operationId": "command_center_capabilities",
        "summary": "Discover Command Center Capabilities & Domain Hubs",
        "description": "Returns dynamic registry of available hubs (core, dev, lab, creative, assets), sub-actions, parameters, and permission scopes.",
        "responses": {
          "200": {
            "description": "Command center capabilities registry",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/luna/command-center/core": {
      "post": {
        "operationId": "command_center_core",
        "summary": "Execute Core Personal Field Sub-Action",
        "description": "Executes sub-actions across lunar context, echoes, reflections, loops, threads, and chat sessions.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "description": "Sub-action identifier (e.g. lunar.get_context, field.search, loops.list, echoes.create)"
                  },
                  "payload": {
                    "type": "object",
                    "description": "Action-specific payload"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sub-action execution result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/luna/command-center/dev": {
      "post": {
        "operationId": "command_center_dev",
        "summary": "Execute Dev Bridge Sub-Action",
        "description": "Executes Development Bridge sub-actions for issues, sessions, events, and telemetry.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "description": "Sub-action identifier (e.g. dev.issues.list, dev.events.post, dev.sessions.claim)"
                  },
                  "payload": {
                    "type": "object",
                    "description": "Action-specific payload"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sub-action execution result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/luna/command-center/lab": {
      "post": {
        "operationId": "command_center_lab",
        "summary": "Execute Attention Lab Sub-Action",
        "description": "Executes Attention Lab V1.1.0 and Model Routing Lab experimental operations.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "description": "Sub-action identifier (e.g. lab.status, lab.attention.plan, lab.attention.run)"
                  },
                  "payload": {
                    "type": "object",
                    "description": "Action-specific payload"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sub-action execution result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/luna/command-center/creative": {
      "post": {
        "operationId": "command_center_creative",
        "summary": "Execute Creative Studio Sub-Action",
        "description": "Executes Creative Studio sub-actions for manifests, shot directions, and render lock status.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "description": "Sub-action identifier (e.g. creative.manifest.get, creative.shots.list, creative.status, creative.render_lock.status)"
                  },
                  "payload": {
                    "type": "object",
                    "description": "Action-specific payload"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sub-action execution result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/luna/command-center/assets": {
      "post": {
        "operationId": "command_center_assets",
        "summary": "Execute Asset Bridge Sub-Action",
        "description": "Executes Asset Bridge operations: list review-state previews, upload binary data, get download URLs, and acknowledge ingestion.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "action"
                ],
                "properties": {
                  "action": {
                    "type": "string",
                    "description": "Sub-action identifier (e.g. assets.list, assets.get, assets.upload, assets.ack)"
                  },
                  "payload": {
                    "type": "object",
                    "description": "Action-specific payload"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sub-action execution result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    }
  }
}